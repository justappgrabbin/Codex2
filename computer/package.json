{
  "name": "synthai-computer-reassembly",
  "private": true,
  "type": "module",
  "scripts": {
    "install:shell": "npm --prefix shell/kimi-linux ci",
    "build": "npm --prefix shell/kimi-linux run build",
    "start": "node host/server.mjs",
    "test:reassembly": "node --test tests/reassembly-ingest-e2e.test.mjs tests/import-preservation.test.mjs tests/execute-intake-preservation.test.mjs tests/registry-recovery.test.mjs tests/http-origin-boundary.test.mjs",
    "test:generative": "node --test tests/shared-generative*.test.mjs",
    "test:integration": "npm run test:reassembly && npm run test:generative && npm run test:learning",
    "test:learning": "node --test tests/learning-workspace.test.mjs"
  },
  "dependencies": {
    "quickjs-emscripten": "0.31.0"
  }
}
